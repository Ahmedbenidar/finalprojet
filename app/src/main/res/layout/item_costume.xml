<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Image du costume -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Image du costume"
            android:layout_marginBottom="8dp" />

        <!-- Nom du costume -->
        <TextView
            android:id="@+id/nomTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du costume"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Costume Pirate" />

        <!-- Type du costume -->
        <TextView
            android:id="@+id/typeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Type"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            tools:text="Historique" />

        <!-- Prix -->
        <TextView
            android:id="@+id/prixTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0.00 €"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold"
            tools:text="29.99 €" />

        <!-- Disponibilité -->
        <TextView
            android:id="@+id/disponibiliteTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Disponible"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:gravity="center"
            tools:text="En stock" />

    </LinearLayout>

</androidx.cardview.widget.CardView>